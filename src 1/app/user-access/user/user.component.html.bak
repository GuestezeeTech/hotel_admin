<div class="main">
    <app-alerts></app-alerts>
    <div class="centered-container">
        <div class="container">
            <h5 class="fw-bolder" style="margin-bottom: 0">
                {{ isViewMode ? 'View User' : (enableEdit ? 'Edit User' : 'Add User') }}
            </h5>
            <p style="color: #9E9E9E; font-size: 14px; margin-bottom: 1%">
                {{ isViewMode ? 'View User Details' : (enableEdit ? 'Update User' : 'Create User') }}
            </p>
            <form [formGroup]="usersForm">
                <div class="row">
                    <!-- Email -->
                    <div class="col-md-4 form-group">
                        <label class="fw-semibold" style="font-size: 15px">Email</label>
                        <input type="email" class="form-control" formControlName="email"
                            [class.is-invalid]="validateForm && f['email'].errors">
                        <div class="invalid-feedback" *ngIf="f['email'].errors">
                            <div *ngIf="f['email'].errors['required']">Please enter email</div>
                            <div *ngIf="f['email'].errors['email']">Invalid email</div>
                            <div *ngIf="f['email'].errors['maxlength']">Email length exceeded</div>
                        </div>
                    </div>
                    <!-- Password (only for Add User) -->
                    <div class="col-md-4 form-group">
                        <label class="fw-semibold" style="font-size: 14px">
                            Password
                        </label>
                        <div class="input-group">
                            <input type="text" placeholder="********" class="form-control" formControlName="password"
                                [class.is-invalid]="validateForm && usersForm.get('password')?.invalid">
                        </div>
                        <div class="invalid-feedback" *ngIf="validateForm && usersForm.get('password')?.invalid">
                            <div *ngIf="usersForm.get('password')?.errors?.['required']">
                                Please enter password
                            </div>
                            <div *ngIf="usersForm.get('password')?.errors?.['minlength']">
                                Password should be at least 6 characters
                            </div>
                        </div>
                    </div>
                    <!-- First Name -->
                    <div class="col-md-4 form-group">
                        <label class="fw-semibold" style="font-size: 14px">First Name</label>
                        <input type="text" class="form-control" formControlName="first_name"
                            [class.is-invalid]="validateForm && f['first_name'].errors">
                        <div class="invalid-feedback" *ngIf="f['first_name'].errors">
                            <div *ngIf="f['first_name'].errors['required']">Please enter first name</div>
                            <div *ngIf="f['first_name'].errors['minlength']">First name is too short</div>
                            <div *ngIf="f['first_name'].errors['maxlength']">Maximum length exceeded</div>
                        </div>
                    </div>

                </div>
                <div class="row mt-3 border-bottom">
                    <!-- Last Name -->
                    <div class="col-md-4 form-group">
                        <label class="fw-semibold" style="font-size: 14px">Last Name</label>
                        <input type="text" class="form-control" formControlName="last_name"
                            [class.is-invalid]="validateForm && f['last_name'].errors">
                        <div class="invalid-feedback" *ngIf="f['last_name'].errors">
                            <div *ngIf="f['last_name'].errors['required']">Please enter last name</div>
                            <div *ngIf="f['last_name'].errors['minlength']">Last name is too short</div>
                            <div *ngIf="f['last_name'].errors['maxlength']">Maximum length exceeded</div>
                        </div>
                    </div>
                    <!-- Phone Number -->
                    <div class="col-md-4 form-group">
                        <label class="fw-semibold" style="font-size: 14px">Phone Number</label>
                        <input type="tel" class="form-control" placeholder="+91" formControlName="phone_number"
                            (input)="validatePhoneNumber($event)" maxlength="10"
                            [class.is-invalid]="validateForm && f['phone_number'].errors">
                        <div class="invalid-feedback" *ngIf="f['phone_number'].errors">
                            <div *ngIf="f['phone_number'].errors['required']">Please enter phone number</div>
                            <div *ngIf="f['phone_number'].errors['pattern']">Invalid phone number</div>
                            <div *ngIf="f['phone_number'].errors['maxlength']">Maximum 10 digits allowed</div>
                        </div>
                    </div>
                    <!-- Role -->
                    <div class="col-md-4 mb-4 form-group">
                        <label class="fw-semibold" style="font-size: 14px">Role</label>
                        <select class="form-control" formControlName="role_name" style="appearance: auto;"
                            [class.is-invalid]="validateForm && f['role_name'].errors">
                            <option value="">Please select</option>
                            <option *ngFor="let list of roleList" [value]="list.name">{{ list.name }}</option>
                        </select>
                        <div class="invalid-feedback" *ngIf="f['role_name'].errors">
                            <div *ngIf="f['role_name'].errors['required']">Please select a role</div>
                        </div>
                    </div>
                </div>
                <!-- Created Details -->
                <h5 class="fw-bolder mt-2" style="margin-bottom: 0">Created Details</h5>
                <div class="row border-bottom">
                    <div class="col-md-4">
                        <label class="fw-semibold mt-3" style="font-size: 14px;">Created By</label>
                        <input type="text" class="form-control mb-4" formControlName="created_by_name"
                            [readonly]="enableEdit" style="color: #8F9899; font-size: 14px;">
                    </div>
                </div>
                <!-- Locked & Active Toggles -->
                <div class="row mt-4 form-group">
                    <div class="col-md-2">
                        <div
                            style="display: flex; align-items: center; border: 1px solid #ddd; padding: 5px 10px; border-radius: 10px;">
                            <span style="font-weight: 600; font-size: 15px;">Locked</span>
                            <input type="checkbox" formControlName="is_locked" hidden #isLockedCheckbox>
                            <i [ngClass]="isLockedCheckbox.checked ? 'bi bi-toggle-on' : 'bi bi-toggle-off'"
                                (click)="!isViewMode && isLockedCheckbox.click()"
                                [ngStyle]="{
                                    'cursor': isViewMode ? 'not-allowed' : 'pointer',
                                    'font-size': '25px',
                                    'margin-left': '8px',
                                    'color': isLockedCheckbox.checked ? '#1AA080' : 'rgb(212, 14, 14)',
                                    'opacity': isViewMode ? 0.6 : 1
                                }">
                            </i>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div
                            style="display: flex; align-items: center; border: 1px solid #ddd; padding: 5px 10px; border-radius: 10px;">
                            <span style="font-weight: 600; font-size: 15px;">Active</span>
                            <input type="checkbox" formControlName="is_active" hidden #isActiveCheckbox>
                            <i [ngClass]="isActiveCheckbox.checked ? 'bi bi-toggle-on' : 'bi bi-toggle-off'"
                                (click)="!isViewMode && isActiveCheckbox.click()"
                                [ngStyle]="{
                                    'cursor': isViewMode ? 'not-allowed' : 'pointer',
                                    'font-size': '25px',
                                    'margin-left': '8px',
                                    'color': isActiveCheckbox.checked ? '#1AA080' : 'rgb(212, 14, 14)',
                                    'opacity': isViewMode ? 0.6 : 1
                                }">
                            </i>
                        </div>
                    </div>
                </div>
            </form>
        </div> <!-- End of container -->
    </div>
    <!-- Buttons placed outside of the container but still inside the *ngIf block -->
    <div class="row my-4  me-1">
        <div class="col-md-12 d-flex justify-content-end">
            <div class="col-md-2">
                <button class="btn w-100 fw-semibold" style="color: #4E4E4E; background-color: #C6C6C6"
                    (click)="openExitModal()">Cancel</button>
            </div>
            <div class="col-md-2" *ngIf="!enableEdit">
                <button class="btn w-100 ms-2 fw-semibold"
                    style="color: white; background-color: #800020;"
                    (click)="sendData()"
                    [disabled]="isViewMode"
                    [ngStyle]="{
                        cursor: isViewMode ? 'not-allowed' : 'pointer',
                        opacity: isViewMode ? 0.6 : 1
                    }">Save</button>
            </div>
            <div class="col-md-2" *ngIf="enableEdit">
                <button class="btn w-100 ms-2 fw-semibold"
                    style="color: white; background-color: #800020;"
                    (click)="sendData()"
                    [disabled]="isViewMode"
                    [ngStyle]="{
                        cursor: isViewMode ? 'not-allowed' : 'pointer',
                        opacity: isViewMode ? 0.8 : 1
                    }">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal for Exiting -->
<div *ngIf="isExitModalOpen"
    style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.5); display: flex; justify-content: center; align-items: center;">
    <div
        style="background: white; padding: 30px; border-radius: 15px; width: 450px; text-align: center; box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.2);">
        <!-- Confirmation Text -->
        <h2 style="margin-bottom: 10px; font-size: 20px; font-weight: bold;">Are you sure you want to exit?</h2>
        <!-- Warning Text (optional) -->
        <p style="font-size: 16px; margin-bottom: 20px;">{{ enableEdit ? 'Any unsaved changes will be lost.' : 'Entered
            details will be lost.'}}</p>
        <!-- Buttons: Cancel and Confirm -->
        <div style="display: flex; justify-content: space-around;">
            <button
                style="padding: 12px; background: #E1E2EB; color: black; border: none; cursor: pointer; width: 45%; border-radius: 8px;"
                (click)="closeExitModal()">
                Cancel
            </button>
            <button
                style="padding: 12px; background: #800020; color: white; border: none; cursor: pointer; width: 45%; border-radius: 8px;"
                (click)="togglCloseAddUser()">
                Exit
            </button>
        </div>
    </div>
</div>