<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /hotel-registration/

  # Serve existing files (JS, CSS, assets) — do not rewrite to index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /hotel-registration/index.html [L]
</IfModule>
